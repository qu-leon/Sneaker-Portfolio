{
  "name": "sneaker-portfolio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sneaks-api": "node kicksdb-api-server.cjs",
    "kicksdb-api": "node kicksdb-api-server.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:security": "vitest run --project security",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "security:audit": "npm audit",
    "security:secrets": "gitleaks git --redact --no-banner"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  }
}
